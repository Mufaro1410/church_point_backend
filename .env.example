APP_ENV=development
HOST=127.0.0.1
PORT=8080
# Supabase dashboard -> Connect -> choose "Session pooler" (port 5432) or Direct connection.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres
DB_MAX_CONNECTIONS=10
# Supabase dashboard -> Project Settings -> JWT (the HS256 "JWT secret").
SUPABASE_JWT_SECRET=paste-your-supabase-jwt-secret-here
# Your project URL, e.g. https://abcdefgh.supabase.co  (used to validate sermon audio URLs)
SUPABASE_URL=
# Axum calls Supabase Auth/Storage for the apps. Keep both ONLY here, never in the web/mobile app.
# anon key: the public key (login, refresh, sign-up).  service role key: SECRET (storage signing, cleanup).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173
RUST_LOG=churchpoint_backend=debug,tower_http=debug,info

# Speed / uploads
DB_MIN_CONNECTIONS=4
AUTH_CACHE_SECONDS=10
FFMPEG_BIN=ffmpeg
AUDIO_MAX_MB=200

# Online payments (Paynow). Generate the key with:  openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
# Public https address of this server, so Paynow can report results (a tunnel while testing)
PUBLIC_BASE_URL=

# Where the "reset password" email link should land (optional)
PASSWORD_RESET_REDIRECT_URL=

# Push notifications (Expo). Reminders go out at local 17:00 the day before and 07:00 on the day, to members who RSVP'd going/maybe.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
REMINDERS_ENABLED=true
APP_TIMEZONE=Africa/Harare
